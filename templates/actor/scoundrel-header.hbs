<div class="dw-header-wrap">
<header class="dw-head">
  <div class="dw-head__portrait">
    <img src="{{actor.img}}" alt="{{actor.name}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
  </div>
  <div class="dw-head__main">
    <div class="dw-head__row">
      <input class="dw-head__name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'DW.Sheet.name'}}" {{#unless editable}}disabled{{/unless}}>
      <label class="dw-field dw-field--alias">
        <span>{{localize "DW.Sheet.alias"}}</span>
        <input type="text" name="system.alias" value="{{system.alias}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
    <div class="dw-head__row">
      <label class="dw-field dw-field--grow">
        <span>{{localize "DW.Sheet.look"}}</span>
        <input type="text" name="system.look" value="{{system.look}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="dw-field">
        <span>{{localize "DW.Sheet.crew"}}</span>
        <select name="system.crewId" {{#unless editable}}disabled{{/unless}}>
          <option value="">—</option>
          {{#each crews}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
    </div>
  </div>
  <div class="dw-head__playbook">
    {{#if playbook}}
    <h1 class="dw-playbook-name" data-action="itemEdit" data-item-id="{{playbook.id}}" data-tooltip="{{pb.tagline}}">{{playbook.name}}</h1>
    <span class="dw-playbook-tag">{{pb.tagline}}{{#if spirit}} · {{localize "DW.Spirit.label"}}{{/if}}</span>
    {{else}}
    <button type="button" class="dw-choose-playbook" data-action="browse">
      <i class="fa-solid fa-book-skull"></i> {{localize "DW.Playbook.choose"}}
    </button>
    <span class="dw-playbook-tag">{{localize "DW.Playbook.dropHint"}}</span>
    {{/if}}
  </div>
</header>
{{#if system.outOfAction}}
<div class="dw-banner dw-banner--out">
  <i class="fa-solid fa-heart-crack"></i> {{localize "DW.Trauma.outBanner"}}
  {{#if editable}}<button type="button" data-action="clearScene">{{localize "DW.Trauma.back"}}</button>{{/if}}
</div>
{{/if}}
{{#if system.retired}}
<div class="dw-banner dw-banner--retired"><i class="fa-solid fa-door-closed"></i> {{localize "DW.Sheet.retiredBanner"}} — {{localize system.retirementLabel}}</div>
{{/if}}
</div>
