<div class="dw-form">
  <label class="dw-field"><span>{{localize "DW.Flashback.what"}}</span><input type="text" name="what" placeholder="{{localize 'DW.Flashback.whatHint'}}"></label>
  <fieldset class="dw-radios dw-radios--stack">
    <legend>{{localize "DW.Flashback.costLabel" label=stressLabel}}</legend>
    <label class="dw-radio"><input type="radio" name="cost" value="0" checked> <strong>0</strong> — {{localize "DW.Flashback.cost0"}}</label>
    <label class="dw-radio"><input type="radio" name="cost" value="1"> <strong>1</strong> — {{localize "DW.Flashback.cost1"}}</label>
    <label class="dw-radio"><input type="radio" name="cost" value="2"> <strong>2</strong> — {{localize "DW.Flashback.cost2"}}</label>
    <label class="dw-radio"><input type="radio" name="cost" value="3"> <strong>3</strong> — {{localize "DW.Flashback.cost3"}}</label>
  </fieldset>
  <p class="dw-hint">{{localize "DW.Flashback.hint"}}</p>
</div>
